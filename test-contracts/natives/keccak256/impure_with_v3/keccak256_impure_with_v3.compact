// Writing the digest to a ledger cell makes the circuit provable, which pulls
// keccak256 into zkir. zkir-v2 has no keccak256 gate, so the same source
// compiles here WITH `--feature-zkir-v3`, and fails in
// ../impure_without_v3 without it.
//
// The pair is split across two fixture directories because a fixture owns
// exactly one contract and one compile expectation. The source is duplicated
// deliberately: each directory stays self-contained, and the copy is small
// enough that drift is visible in review.

pragma language_version >= 0.25.0;

import CompactStandardLibrary;

export ledger digest: Bytes<32>;

export circuit keccak256_writes_ledger(value: Bytes<32>): [] {
    digest = disclose(keccak256<Bytes<32>>(value));
}
