// keccak256 accepts any ORDINARY Compact type. One circuit per type family --
// `Field`, `Bytes<N>`, `Boolean`, `Uint<N>`, `Vector` and a struct -- asserted
// for 32-byte shape, determinism, and distinct digests from distinct inputs.
//
// Encoding correctness for the field-element types is ../field_types; the ADT
// rejection is ../adt_rejected. Pure, so no `--feature-zkir-v3`.

struct Mixed { tag: Bytes<8>, count: Uint<64>, flag: Boolean }

pragma language_version >= 0.25.0;

import CompactStandardLibrary;

export circuit hashField(x: Field): Bytes<32> {
    return disclose(keccak256<Field>(x));
}

export circuit hashBytes32(x: Bytes<32>): Bytes<32> {
    return disclose(keccak256<Bytes<32>>(x));
}

export circuit hashBool(x: Boolean): Bytes<32> {
    return disclose(keccak256<Boolean>(x));
}

export circuit hashUint(x: Uint<64>): Bytes<32> {
    return disclose(keccak256<Uint<64>>(x));
}

export circuit hashVector(x: Vector<4, Field>): Bytes<32> {
    return disclose(keccak256<Vector<4, Field>>(x));
}

export circuit hashStruct(x: Mixed): Bytes<32> {
    return disclose(keccak256<Mixed>(x));
}
