// The observable consequence of the no-trim behaviour across widths: a
// `Bytes<N>` holding a zero-padded copy of a narrower `Bytes<M>` hashes
// DIFFERENTLY, because the padding zeros are hashed and the declared width
// stays visible in the digest. The legacy trim erased the width and made the
// two collide.
//
// The widths are exactly the pairs the runtime test compares -- (33, 32) for a
// single padding zero, (63, 32) across the 2x31 packing boundary, (33, 1) for
// a 32-byte pad, and (94, 93) on the 3x31 straddle -- rather than the whole
// sweep, which is ../multi_length. Pure, so no `--feature-zkir-v3`.

pragma language_version >= 0.25.0;

import CompactStandardLibrary;

export circuit hashBytes1(value: Bytes<1>): Bytes<32> {
    return disclose(keccak256<Bytes<1>>(value));
}

export circuit hashBytes32(value: Bytes<32>): Bytes<32> {
    return disclose(keccak256<Bytes<32>>(value));
}

export circuit hashBytes33(value: Bytes<33>): Bytes<32> {
    return disclose(keccak256<Bytes<33>>(value));
}

export circuit hashBytes63(value: Bytes<63>): Bytes<32> {
    return disclose(keccak256<Bytes<63>>(value));
}

export circuit hashBytes93(value: Bytes<93>): Bytes<32> {
    return disclose(keccak256<Bytes<93>>(value));
}

export circuit hashBytes94(value: Bytes<94>): Bytes<32> {
    return disclose(keccak256<Bytes<94>>(value));
}
