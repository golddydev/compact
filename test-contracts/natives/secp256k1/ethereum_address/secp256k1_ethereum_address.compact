// The standard library's `secp256k1EthereumAddress` circuit, which derives the
// canonical Ethereum address from a public key:
//
//   keccak256(x_be(32) || y_be(32))[12:32)
//
// i.e. keccak over the big-endian uncompressed coordinates, taking the LAST 20
// bytes. That is the real EIP derivation, so the runtime test holds it to the
// canonical `ethereum/tests` key-to-address vectors and expects a match.
//
// The point at infinity is rejected by the stdlib assert -- it has no address.
//
// Pure, so no proving keys, but `--feature-zkir-v3` is required both for
// `Secp256k1Point` and because the circuit hashes a curve point.

pragma language_version >= 0.25.0;

import CompactStandardLibrary;

export circuit ethereumAddress(pk: Secp256k1Point): Bytes<20> {
    return disclose(secp256k1EthereumAddress(pk));
}
