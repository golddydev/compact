// Two and three `secp256k1EcdsaVerify` gates instantiated in a SINGLE circuit,
// run sequentially over the same digest with independent (signature, key)
// pairs. The point is that repeated instantiation does not panic the compiler
// or blow up lowering.
//
// The ledger write makes these provable, so this is real zkir v3 lowering with
// proving-key generation -- hence `slow/`, which the orchestrator compiles
// exclusively. Compile coverage only: the verdicts themselves are
// ../../ecdsa_verify's job.

pragma language_version >= 0.25.0;

import CompactStandardLibrary;

export ledger n: Uint<64>;

witness sigOf(i: Uint<8>): Secp256k1EcdsaSignature;
witness keyOf(i: Uint<8>): Secp256k1Point;

export circuit two(d: Bytes<32>): [] {
    const a = secp256k1EcdsaVerify(d, sigOf(0), keyOf(0));
    const b = secp256k1EcdsaVerify(d, sigOf(1), keyOf(1));
    n = disclose((a && b) ? 1 : 0);
}

export circuit three(d: Bytes<32>): [] {
    const a = secp256k1EcdsaVerify(d, sigOf(0), keyOf(0));
    const b = secp256k1EcdsaVerify(d, sigOf(1), keyOf(1));
    const c = secp256k1EcdsaVerify(d, sigOf(2), keyOf(2));
    n = disclose((a && b && c) ? 1 : 0);
}
