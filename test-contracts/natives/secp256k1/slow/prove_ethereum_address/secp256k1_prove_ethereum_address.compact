// The provable counterpart of ../../ethereum_address: writing the derived
// address to a ledger cell makes the circuit provable, so
// `secp256k1EthereumAddress` -- keccak256 over a curve point -- has to survive
// zkir v3 lowering rather than only running off-chain.
//
// That lowering used to crash with a `cannot-happen` in `zkir-v3-passes.ss`;
// it was fixed by "Handle alignment for curve points in ZKIR v3"
// (LFDT-Minokawa/compact#612). This fixture pins the fix, keys and all, which
// is why it lives under `slow/`.

pragma language_version >= 0.25.0;

import CompactStandardLibrary;

export ledger lastAddr: Bytes<20>;

export circuit storeEthereumAddress(pk: Secp256k1Point): Bytes<20> {
    const addr = secp256k1EthereumAddress(pk);
    lastAddr = disclose(addr);
    return disclose(addr);
}
