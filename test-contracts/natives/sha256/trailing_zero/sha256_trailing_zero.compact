// EDGE CASE -- trailing zero bytes under `persistentHash`.
//
// A `Bytes<N>` is serialized with its trailing 0x00 run trimmed
// (`CompactTypeBytes.toValue`), and the width is restored from the alignment
// when the value is hashed. keccak256 is pinned against that behaviour by
// ../../keccak256/trailing_zero, but `persistentHash` takes a different route
// -- it hands the trimmed value and the alignment to the Rust on-chain runtime
// rather than going through `toBinaryRepr` -- so the same guarantee is worth
// its own fixture.
//
// The upstream sha256 vectors sidestep this entirely by using all-nonzero
// filler inputs, so nothing covered it before. One width is enough: the
// runtime test varies the byte pattern.

pragma language_version >= 0.25.0;

import CompactStandardLibrary;

export circuit hashBytes12(value: Bytes<12>): Bytes<32> {
    return disclose(persistentHash<Bytes<12>>(value));
}
